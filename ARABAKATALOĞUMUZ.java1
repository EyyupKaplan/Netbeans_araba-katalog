    // Özellik 4: Koyu Tema Uygulama Metodu
    private void temaDegistir(boolean koyuMu) {
        if (koyuMu) {
            getContentPane().setBackground(new Color(45, 45, 45));
            lblBaslik.setForeground(Color.WHITE);
            // Tüm etiketlerin rengini beyaz yap
            Component[] bileşenler = getContentPane().getComponents();
            for (Component c : bileşenler) {
                if (c instanceof JLabel) {
                    ((JLabel) c).setForeground(Color.WHITE);
                }
            }
            chkDarkMode.setForeground(Color.WHITE);
            chkDarkMode.setBackground(new Color(45, 45, 45));
            txtSonuc.setBackground(new Color(30, 30, 30));
            txtSonuc.setForeground(Color.GREEN);
        } else {
            getContentPane().setBackground(null);
            lblBaslik.setForeground(Color.BLACK);
            Component[] bileşenler = getContentPane().getComponents();
            for (Component c : bileşenler) {
                if (c instanceof JLabel) {
                    ((JLabel) c).setForeground(Color.BLACK);
                }
            }
            chkDarkMode.setForeground(Color.BLACK);
            chkDarkMode.setBackground(null);
            txtSonuc.setBackground(Color.WHITE);
            txtSonuc.setForeground(Color.BLACK);
        }
    }

    // Özellik 1: Test Sürüşü Randevu Formu Açma (JDialog)
    private void testSurusuPenceresiAc() {
        JDialog dialog = new JDialog(this, "Test Sürüşü Randevu Formu", true);
        dialog.setSize(380, 320);
        dialog.setLayout(null);
        dialog.setLocationRelativeTo(this);

        JLabel lblAdSoyad = new JLabel("Ad Soyad:");
        lblAdSoyad.setBounds(30, 30, 100, 25);
        dialog.add(lblAdSoyad);

        JTextField txtAdSoyad = new JTextField();
        txtAdSoyad.setBounds(130, 30, 190, 25);
        dialog.add(txtAdSoyad);

        JLabel lblTelefon = new JLabel("Telefon:");
        lblTelefon.setBounds(30, 70, 100, 25);
        dialog.add(lblTelefon);

        JTextField txtTelefon = new JTextField();
        txtTelefon.setBounds(130, 70, 190, 25);
        dialog.add(txtTelefon);

        JLabel lblAracModel = new JLabel("İstediğiniz Model:");
        lblAracModel.setBounds(30, 110, 100, 25);
        dialog.add(lblAracModel);

        JTextField txtAracModel = new JTextField();
        txtAracModel.setBounds(130, 110, 190, 25);
        dialog.add(txtAracModel);

        JLabel lblTarih = new JLabel("Randevu Tarihi:");
        lblTarih.setBounds(30, 150, 100, 25);
        dialog.add(lblTarih);

        JTextField txtTarih = new JTextField("GG.AA.YYYY");
        txtTarih.setBounds(130, 150, 190, 25);
        dialog.add(txtTarih);

        JButton btnOnayla = new JButton("Randevuyu Onayla");
        btnOnayla.setBounds(130, 200, 190, 35);
        dialog.add(btnOnayla);

        btnOnayla.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                if (txtAdSoyad.getText().trim().isEmpty() || txtTelefon.getText().trim().isEmpty() || txtAracModel.getText().trim().isEmpty()) {
                    JOptionPane.showMessageDialog(dialog, "Lütfen tüm alanları doldurunuz!");
                } else {
                    JOptionPane.showMessageDialog(dialog, "Sayın " + txtAdSoyad.getText() + ",\n" + txtAracModel.getText() + " modeli için " + txtTarih.getText() + " tarihindeki test sürüşü randevunuz başarıyla oluşturulmuştur.");
                    dialog.dispose();
                }
            }
        });

        dialog.setVisible(true);
    }

    // Formu Temizleme
    private void formuTemizle() {
        cbYakit.setSelectedIndex(0);
        cbKasa.setSelectedIndex(0);
        cbMarka.setSelectedIndex(0);
        cbTur.setSelectedIndex(0);
        cbMotor.setSelectedIndex(0);
        cbVites.setSelectedIndex(0);
        cbRenk.setSelectedIndex(0);
        cbSiralama.setSelectedIndex(0);
        txtMinFiyat.setText("0");
        txtMaxFiyat.setText("10000000");
        txtSonuc.setText("");
        chkDarkMode.setSelected(false);
        temaDegistir(false);
    }

    // Arama, Filtreleme, Sıralama ve Esnek Öneri Mantığı
    private void arabaBulVeGoster() {
        String secilenYakit = (String) cbYakit.getSelectedItem();
        String secilenKasa = (String) cbKasa.getSelectedItem();
        String secilenMarka = (String) cbMarka.getSelectedItem();
        String secilenTur = (String) cbTur.getSelectedItem();
        String secilenMotor = (String) cbMotor.getSelectedItem();
        String secilenVites = (String) cbVites.getSelectedItem();
        String secilenRenk = (String) cbRenk.getSelectedItem();
        int siralamaTuru = cbSiralama.getSelectedIndex();

        if (secilenYakit.equals("Seçiniz...") || secilenKasa.equals("Seçiniz...") || 
            secilenMarka.equals("Seçiniz...")) {
            txtSonuc.setText("Lütfen en azından Yakıt Türü, Kasa Tipi ve Marka alanlarını seçiniz!\n\nBizi tercih ettiğiniz için teşekkürler.");
            return;
        }

        double minFiyat = 0;
        double maxFiyat = Double.MAX_VALUE;
        try {
            if (!txtMinFiyat.getText().trim().isEmpty()) {
                minFiyat = Double.parseDouble(txtMinFiyat.getText().trim());
            }
            if (!txtMaxFiyat.getText().trim().isEmpty()) {
                maxFiyat = Double.parseDouble(txtMaxFiyat.getText().trim());
            }
        } catch (NumberFormatException ex) {
            txtSonuc.setText("Lütfen fiyat alanlarına geçerli sayılar giriniz!");
            return;
        }

        ArrayList<Araba> bulunanlar = new ArrayList<>();
        
        for (Araba a : arabaListesi) {
            boolean uygunluk = a.yakitTuru.equals(secilenYakit) && 
                               a.kasaTipi.equals(secilenKasa) && 
                               a.marka.equals(secilenMarka) &&
                               a.fiyat >= minFiyat && a.fiyat <= maxFiyat;

            if (!secilenTur.equals("Seçiniz...") && !a.aracTuru.equals(secilenTur)) uygunluk = false;
            if (!secilenMotor.equals("Seçiniz...") && !a.motorHacmi.equals(secilenMotor)) uygunluk = false;
            if (!secilenVites.equals("Seçiniz...") && !a.vitesTuru.equals(secilenVites)) uygunluk = false;

            if (uygunluk) {
                bulunanlar.add(a);
            }
        }

        boolean alternatifMi = false;
        if (bulunanlar.isEmpty()) {
            alternatifMi = true;
            for (Araba a : arabaListesi) {
                if ((a.marka.equals(secilenMarka) || a.yakitTuru.equals(secilenYakit)) && 
                    a.fiyat >= minFiyat && a.fiyat <= maxFiyat) {
                    bulunanlar.add(a);
                }
            }
        }

        if (!bulunanlar.isEmpty()) {
            if (siralamaTuru == 1) {
                Collections.sort(bulunanlar, Comparator.comparingDouble(a -> a.fiyat));
            } else if (siralamaTuru == 2) {
                Collections.sort(bulunanlar, (a, b) -> Double.compare(b.fiyat, a.fiyat));
            } else if (siralamaTuru == 3) {
                Collections.sort(bulunanlar, (a, b) -> Double.compare(b.kullaniciPuani, a.kullaniciPuani));
            }
        }

        StringBuilder sb = new StringBuilder();
        if (!bulunanlar.isEmpty()) {
            if (alternatifMi) {
                sb.append("=== TAM EŞLEŞEN ARAÇ YOK, ALTERNATİFLER SUNULDU ===\n\n");
            } else {
                sb.append("=== SİZE ÖZEL ARABA ÖNERİLERİ ===\n\n");
            }
            
            for (int i = 0; i < bulunanlar.size(); i++) {
                sb.append("Size göre araba ").append(i + 1).append(":\n");
                sb.append(bulunanlar.get(i).getBilgiler(secilenRenk)).append("\n");
                sb.append("--------------------------------------------------\n");
            }
        } else {
            sb.append("Uygun araba yok.\n\n");
        }

        sb.append("\nBizi tercih ettiğiniz için teşekkürler.");
        txtSonuc.setText(sb.toString());
    }

    // Main metodu
    public static void main(String[] args) {
        java.awt.EventQueue.invokeLater(new Runnable() {
            public void run() {
                new ARABAKATALOĞUMUZ().setVisible(true);
            }
        });
    }
