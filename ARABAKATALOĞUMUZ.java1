package araba.kataloğumuz;

import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;

// Araba sınıfı: Araç detaylarını, tüketim miktarını ve hediye koşullarını tutar
class Araba {
    String yakitTuru;
    String kasaTipi;
    String marka;
    String model;
    String motorHacmi;
    String vitesTuru;
    String aracTuru;
    int yil;
    double fiyat;
    String hizlanma;
    double kullaniciPuani;
    String ulke;
    String ozellikler;
    String taksitBilgisi;
    String tuketim;

    public Araba(String yakitTuru, String kasaTipi, String marka, String model, String motorHacmi, String vitesTuru, String aracTuru, int yil, double fiyat, String hizlanma, double kullaniciPuani, String ulke, String ozellikler, String taksitBilgisi, String tuketim) {
        this.yakitTuru = yakitTuru;
        this.kasaTipi = kasaTipi;
        this.marka = marka;
        this.model = model;
        this.motorHacmi = motorHacmi;
        this.vitesTuru = vitesTuru;
        this.aracTuru = aracTuru;
        this.yil = yil;
        this.fiyat = fiyat;
        this.hizlanma = hizlanma;
        this.kullaniciPuani = kullaniciPuani;
        this.ulke = ulke;
        this.ozellikler = ozellikler;
        this.taksitBilgisi = taksitBilgisi;
        this.tuketim = tuketim;
    }

    // Araç bilgilerini formatlı döndüren metot
    public String getBilgiler(String secilenRenk) {
        String renkGosterge = (secilenRenk == null || secilenRenk.equals("Seçiniz...")) ? "Standart / Belirtilmedi" : secilenRenk;
        
        String bilgi = "Marka: " + marka + " | Model: " + model + " | Tür: " + aracTuru + "\n" +
               "Ülke: " + ulke + " | Yıl: " + yil + " | Vites: " + vitesTuru + "\n" +
               "Yakıt: " + yakitTuru + " | Kasa: " + kasaTipi + " | Motor: " + motorHacmi + "\n" +
               "0-100: " + hizlanma + " | Tüketim: " + tuketim + "\n" +
               "Kullanıcı Puanı: " + kullaniciPuani + "/10 | Seçilen Renk: " + renkGosterge + "\n" +
               "Taksit İmkanı: " + taksitBilgisi + " | Fiyat: " + String.format("%,.0f", fiyat) + " TL\n" +
               "Özellikler: " + ozellikler;

        if (fiyat > 2000000) {
            bilgi += "\n[NOT: 2.000.000 TL üzeri satışlarda Temizlik Kiti ve 4 Adet Lastik Hediyedir!]";
        }

        return bilgi;
    }
}

